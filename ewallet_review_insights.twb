  <dashboards>
    <dashboard enable-sort-zone-taborder='true' name='1 Market &amp; Scorecard'>
      <style />
      <size maxheight='800' maxwidth='1300' minheight='800' minwidth='1300' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Reviews' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Latest 500&quot;'>
          <calculation class='tableau' formula='&quot;Latest 500&quot;' />
          <members>
            <member value='&quot;Latest 500&quot;' />
            <member value='&quot;Most helpful&quot;' />
          </members>
        </column>
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='13' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='10503' id='1' type-v2='text' w='78000' x='615' y='1000'>
            <formatted-text>
              <run bold='true' fontcolor='#1f2d3d' fontsize='15'>E-money grew 4.3x since 2021, but satisfaction is split in two</run>
              <run>Æ&#10;</run>
              <run fontcolor='#6b7785' fontsize='9'>GoPay, DANA and ShopeePay average 3.2-3.7 stars; OVO and LinkAja sit below 1.6, with most reviews at 1 star</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='10503' id='2' mode='compact' param='[Parameters].[Parameter 2]' type-v2='paramctrl' w='20385' x='79000' y='1000'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#ffffff' />
            </zone-style>
          </zone>
          <zone h='12684' id='3' type-v2='text' w='24400' x='615' y='11701'>
            <formatted-text>
              <run bold='true' fontcolor='#1f2d3d' fontsize='20'>32.0 bn</run>
              <run>Æ&#10;</run>
              <run fontcolor='#6b7785' fontsize='9'>transactions in 2025 (3.9x vs 2021)</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f4f6f8' />
            </zone-style>
          </zone>
          <zone h='12684' id='4' type-v2='text' w='24400' x='25315' y='11701'>
            <formatted-text>
              <run bold='true' fontcolor='#1f2d3d' fontsize='20'>Rp 3,362 tn</run>
              <run>Æ&#10;</run>
              <run fontcolor='#6b7785' fontsize='9'>value in 2025 (4.3x vs 2021)</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f4f6f8' />
            </zone-style>
          </zone>
          <zone h='12684' id='5' type-v2='text' w='24400' x='50015' y='11701'>
            <formatted-text>
              <run bold='true' fontcolor='#1f2d3d' fontsize='20'>1.07 bn</run>
              <run>Æ&#10;</run>
              <run fontcolor='#6b7785' fontsize='9'>e-money instruments (1.9x)</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
