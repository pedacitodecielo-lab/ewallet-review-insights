            <column caption='App' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;All apps&quot;'>
              <calculation class='tableau' formula='&quot;All apps&quot;' />
            </column>
            <column caption='Reviews' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Latest 500&quot;'>
              <calculation class='tableau' formula='&quot;Latest 500&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.ewalletreviews01'>
            <column caption='App' datatype='string' name='[App]' role='dimension' type='nominal' />
            <column caption='App in selection' datatype='boolean' name='[Calc_AppFilter]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;All apps&quot; OR [App] = [Parameters].[Parameter 1]' />
            </column>
            <column caption='Has complaint theme' datatype='boolean' name='[Calc_IsTheme]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Theme] &lt;&gt; &quot;(no complaint theme)&quot;' />
            </column>
            <column caption='Lens in selection' datatype='boolean' name='[Calc_LensFilter]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Lens] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='Reviews' datatype='integer' default-format='n#,##0;-#,##0' name='[Calc_Reviews]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Review ID])' />
            </column>
            <column caption='1-Star Share of Theme' datatype='real' default-format='p0%' name='[Calc_Severity]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([One Star])' />
            </column>
            <column caption='% of Reviews' datatype='real' default-format='p0.0%' name='[Calc_Share]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Share Weight]) / COUNTD([App])' />
            </column>
            <column caption='Lens' datatype='string' name='[Lens]' role='dimension' type='nominal' />
            <column caption='One Star' datatype='integer' name='[One Star]' role='measure' type='quantitative' />
