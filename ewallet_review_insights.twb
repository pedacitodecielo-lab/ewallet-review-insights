    </worksheet>
    <worksheet name='DANA vs peers'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>DANA vs peer average (gap in percentage points)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dashboard_reviews' name='federated.ewalletreviews01' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Reviews' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Latest 500&quot;'>
              <calculation class='tableau' formula='&quot;Latest 500&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.ewalletreviews01'>
            <column caption='App' datatype='string' name='[App]' role='dimension' type='nominal' />
            <column caption='DANA %' datatype='real' default-format='p0.0%' name='[Calc_DanaShare]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [App] = &quot;DANA&quot; THEN [Share Weight] END)' />
            </column>
            <column caption='Gap Direction' datatype='string' name='[Calc_GapColor]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calc_Gap] &gt; 0 THEN &quot;DANA worse than peers&quot; ELSE &quot;DANA better than peers&quot; END' />
            </column>
            <column caption='DANA Gap vs Peers (pp)' datatype='real' default-format='n+#,##0.0;-#,##0.0' name='[Calc_Gap]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calc_DanaShare] - [Calc_PeerShare]) * 100' />
            </column>
            <column caption='Has complaint theme' datatype='boolean' name='[Calc_IsTheme]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Theme] &lt;&gt; &quot;(no complaint theme)&quot;' />
            </column>
            <column caption='Lens in selection' datatype='boolean' name='[Calc_LensFilter]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Lens] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='Peer Avg %' datatype='real' default-format='p0.0%' name='[Calc_PeerShare]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [App] &lt;&gt; &quot;DANA&quot; THEN [Share Weight] END) / 4' />
            </column>
            <column caption='Lens' datatype='string' name='[Lens]' role='dimension' type='nominal' />
            <column caption='Share Weight' datatype='real' name='[Share Weight]' role='measure' type='quantitative' />
            <column caption='Theme' datatype='string' name='[Theme]' role='dimension' type='nominal' />
            <column-instance column='[Calc_IsTheme]' derivation='None' name='[none:Calc_IsTheme:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calc_LensFilter]' derivation='None' name='[none:Calc_LensFilter:nk]' pivot='key' type='nominal' />
            <column-instance column='[Theme]' derivation='None' name='[none:Theme:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calc_DanaShare]' derivation='User' name='[usr:Calc_DanaShare:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calc_Gap]' derivation='User' name='[usr:Calc_Gap:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calc_GapColor]' derivation='User' name='[usr:Calc_GapColor:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calc_PeerShare]' derivation='User' name='[usr:Calc_PeerShare:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.ewalletreviews01].[none:Calc_IsTheme:nk]'>
            <groupfilter function='member' level='[none:Calc_IsTheme:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.ewalletreviews01].[none:Calc_LensFilter:nk]'>
            <groupfilter function='member' level='[none:Calc_LensFilter:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <computed-sort column='[federated.ewalletreviews01].[none:Theme:nk]' direction='DESC' using='[federated.ewalletreviews01].[usr:Calc_Gap:qk]' />
          <slices>
            <column>[federated.ewalletreviews01].[none:Calc_LensFilter:nk]</column>
            <column>[federated.ewalletreviews01].[none:Calc_IsTheme:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.ewalletreviews01].[usr:Calc_GapColor:nk]' type='palette'>
              <map to='#4e9f94'>
                <bucket>&quot;DANA better than peers&quot;</bucket>
              </map>
              <map to='#e15759'>
                <bucket>&quot;DANA worse than peers&quot;</bucket>
              </map>
            </encoding>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.ewalletreviews01].[usr:Calc_GapColor:nk]' />
              <text column='[federated.ewalletreviews01].[usr:Calc_Gap:qk]' />
              <tooltip column='[federated.ewalletreviews01].[usr:Calc_DanaShare:qk]' />
              <tooltip column='[federated.ewalletreviews01].[usr:Calc_PeerShare:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true'><![CDATA[<[federated.ewalletreviews01].[none:Theme:nk]>]]></run>
                <run>Æ&#10;</run>
                <run>DANA: </run>
                <run bold='true'><![CDATA[<[federated.ewalletreviews01].[usr:Calc_DanaShare:qk]>]]></run>
                <run> of reviews   Peer average: </run>
                <run><![CDATA[<[federated.ewalletreviews01].[usr:Calc_PeerShare:qk]>]]></run>
                <run>Æ&#10;</run>
                <run>Gap: </run>
                <run bold='true'><![CDATA[<[federated.ewalletreviews01].[usr:Calc_Gap:qk]>]]></run>
                <run> percentage points</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.ewalletreviews01].[none:Theme:nk]</rows>
        <cols>[federated.ewalletreviews01].[usr:Calc_Gap:qk]</cols>
      </table>
      <simple-id uuid='{7940E35D-7030-4280-94E5-FC2F407D7EF8}' />
    </worksheet>
