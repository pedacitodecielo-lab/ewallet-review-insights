            <column caption='Share Weight' datatype='real' name='[Share Weight]' role='measure' type='quantitative' />
            <column caption='Theme' datatype='string' name='[Theme]' role='dimension' type='nominal' />
            <column-instance column='[App]' derivation='None' name='[none:App:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calc_AppFilter]' derivation='None' name='[none:Calc_AppFilter:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calc_IsTheme]' derivation='None' name='[none:Calc_IsTheme:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calc_LensFilter]' derivation='None' name='[none:Calc_LensFilter:nk]' pivot='key' type='nominal' />
            <column-instance column='[Theme]' derivation='None' name='[none:Theme:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calc_Reviews]' derivation='User' name='[usr:Calc_Reviews:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calc_Severity]' derivation='User' name='[usr:Calc_Severity:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calc_Share]' derivation='User' name='[usr:Calc_Share:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.ewalletreviews01].[none:Calc_AppFilter:nk]'>
