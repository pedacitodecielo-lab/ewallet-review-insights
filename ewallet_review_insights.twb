                <run>Æ&#10;</run>
                <run>Average rating: </run>
                <run bold='true'><![CDATA[<[federated.ewalletreviews01].[usr:Calc_AvgRating:qk]>]]></run>
                <run>Æ&#10;</run>
                <run>1-star reviews: </run>
                <run><![CDATA[<[federated.ewalletreviews01].[usr:Calc_OneStar:qk]>]]></run>
                <run>Æ&#10;</run>
                <run>Reviews in lens: </run>
                <run><![CDATA[<[federated.ewalletreviews01].[usr:Calc_Reviews:qk]>]]></run>
