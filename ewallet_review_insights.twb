    <datasource caption='dashboard_market' inline='true' name='federated.ewalletmarket01' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='dashboard_market' name='textscan.ewalletmarket01'>
            <connection class='textscan' directory='C:/Users/Emelio Exaudi/Documents/Project/Data Analyst/EWallet Review Insights' filename='dashboard_market.csv' password='' server='' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.ewalletmarket01' name='dashboard_market.csv' table='[dashboard_market#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='Metric' ordinal='0' />
            <column datatype='string' name='Period Type' ordinal='1' />
            <column datatype='date' name='Period' ordinal='2' />
            <column datatype='real' name='Value' ordinal='3' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption='Growth since 2021' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calc_Growth]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calc_V2025] / SUM(IF [Period Type] = &quot;Annual&quot; AND YEAR([Period]) = 2021 THEN [Value] END)' />
      </column>
      <column caption='2025' datatype='real' default-format='n#,##0;-#,##0' name='[Calc_V2025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Period Type] = &quot;Annual&quot; AND YEAR([Period]) = 2025 THEN [Value] END)' />
      </column>
      <column caption='Metric' datatype='string' name='[Metric]' role='dimension' type='nominal' />
      <column caption='Period Type' datatype='string' name='[Period Type]' role='dimension' type='nominal' />
