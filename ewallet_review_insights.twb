    <worksheet name='Star-rating mix per app'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>Star-rating mix (red = 1 star, blue = 5 stars)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dashboard_reviews' name='federated.ewalletreviews01' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Reviews' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Latest 500&quot;'>
              <calculation class='tableau' formula='&quot;Latest 500&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.ewalletreviews01'>
            <column caption='App' datatype='string' name='[App]' role='dimension' type='nominal' />
            <column caption='Avg Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calc_AvgRating]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Rating] * [First Row]) / SUM([First Row])' />
            </column>
            <column caption='Lens in selection' datatype='boolean' name='[Calc_LensFilter]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Lens] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='Share of App Reviews' datatype='real' default-format='p0%' name='[Calc_MixShare]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([First Row]) / MIN({FIXED [App], [Lens] : SUM([First Row])})' />
            </column>
            <column caption='Reviews' datatype='integer' default-format='n#,##0;-#,##0' name='[Calc_Reviews]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Review ID])' />
            </column>
            <column caption='First Row' datatype='integer' name='[First Row]' role='measure' type='quantitative' />
            <column caption='Lens' datatype='string' name='[Lens]' role='dimension' type='nominal' />
            <column caption='Rating' datatype='integer' name='[Rating]' role='dimension' type='ordinal' />
            <column caption='Review ID' datatype='string' name='[Review ID]' role='dimension' type='nominal' />
            <column-instance column='[App]' derivation='None' name='[none:App:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calc_LensFilter]' derivation='None' name='[none:Calc_LensFilter:nk]' pivot='key' type='nominal' />
            <column-instance column='[Rating]' derivation='None' name='[none:Rating:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calc_AvgRating]' derivation='User' name='[usr:Calc_AvgRating:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calc_MixShare]' derivation='User' name='[usr:Calc_MixShare:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calc_Reviews]' derivation='User' name='[usr:Calc_Reviews:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.ewalletreviews01].[none:App:nk]' direction='DESC' using='[federated.ewalletreviews01].[usr:Calc_AvgRating:qk]' />
          <filter class='categorical' column='[federated.ewalletreviews01].[none:Calc_LensFilter:nk]'>
            <groupfilter function='member' level='[none:Calc_LensFilter:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.ewalletreviews01].[none:Calc_LensFilter:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.ewalletreviews01].[none:Rating:ok]' type='palette'>
              <map to='#4575b4'>
                <bucket>5</bucket>
              </map>
              <map to='#91bfdb'>
                <bucket>4</bucket>
              </map>
              <map to='#d7301f'>
                <bucket>1</bucket>
              </map>
              <map to='#d9d9d9'>
                <bucket>3</bucket>
              </map>
              <map to='#fc8d59'>
                <bucket>2</bucket>
              </map>
            </encoding>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.ewalletreviews01].[none:Rating:ok]' />
              <tooltip column='[federated.ewalletreviews01].[usr:Calc_Reviews:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true'><![CDATA[<[federated.ewalletreviews01].[none:App:nk]>]]></run>
                <run>: </run>
                <run bold='true'><![CDATA[<[federated.ewalletreviews01].[usr:Calc_MixShare:qk]>]]></run>
                <run> of reviews gave </run>
                <run><![CDATA[<[federated.ewalletreviews01].[none:Rating:ok]>]]></run>
                <run> star(s)</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[federated.ewalletreviews01].[none:App:nk]</rows>
        <cols>[federated.ewalletreviews01].[usr:Calc_MixShare:qk]</cols>
      </table>
      <simple-id uuid='{8F98D147-50CE-4F3B-92CC-D7ECF1EAEBCF}' />
