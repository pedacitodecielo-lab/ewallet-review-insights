    <datasource caption='dashboard_reviews' inline='true' name='federated.ewalletreviews01' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='dashboard_reviews' name='textscan.ewalletreviews01'>
            <connection class='textscan' directory='C:/Users/Emelio Exaudi/Documents/Project/Data Analyst/EWallet Review Insights' filename='dashboard_reviews.csv' password='' server='' workgroup-auth-mode='as-is' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.ewalletreviews01' name='dashboard_reviews.csv' table='[dashboard_reviews#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='Review ID' ordinal='0' />
            <column datatype='string' name='App' ordinal='1' />
            <column datatype='string' name='Peer Group' ordinal='2' />
            <column datatype='string' name='Lens' ordinal='3' />
            <column datatype='date' name='Date' ordinal='4' />
            <column datatype='integer' name='Rating' ordinal='5' />
            <column datatype='string' name='Version' ordinal='6' />
            <column datatype='string' name='Theme' ordinal='7' />
            <column datatype='integer' name='Theme Count' ordinal='8' />
            <column datatype='real' name='Share Weight' ordinal='9' />
            <column datatype='integer' name='First Row' ordinal='10' />
            <column datatype='integer' name='One Star' ordinal='11' />
            <column datatype='integer' name='Negative' ordinal='12' />
            <column datatype='integer' name='Helpful Votes' ordinal='13' />
            <column datatype='string' name='Snippet' ordinal='14' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption='App' datatype='string' name='[App]' role='dimension' type='nominal' />
      <column caption='App in selection' datatype='boolean' name='[Calc_AppFilter]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;All apps&quot; OR [App] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Avg Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calc_AvgRating]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Rating] * [First Row]) / SUM([First Row])' />
      </column>
      <column caption='DANA %' datatype='real' default-format='p0.0%' name='[Calc_DanaShare]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [App] = &quot;DANA&quot; THEN [Share Weight] END)' />
      </column>
      <column caption='Days Covered' datatype='integer' default-format='n#,##0;-#,##0' name='[Calc_Days]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, MIN([Date]), MAX([Date])) + 1' />
      </column>
      <column caption='Gap Direction' datatype='string' name='[Calc_GapColor]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calc_Gap] &gt; 0 THEN &quot;DANA worse than peers&quot; ELSE &quot;DANA better than peers&quot; END' />
      </column>
      <column caption='DANA Gap vs Peers (pp)' datatype='real' default-format='n+#,##0.0;-#,##0.0' name='[Calc_Gap]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calc_DanaShare] - [Calc_PeerShare]) * 100' />
      </column>
      <column caption='Has complaint theme' datatype='boolean' name='[Calc_IsTheme]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Theme] &lt;&gt; &quot;(no complaint theme)&quot;' />
      </column>
      <column caption='Lens in selection' datatype='boolean' name='[Calc_LensFilter]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Lens] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Share of App Reviews' datatype='real' default-format='p0%' name='[Calc_MixShare]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([First Row]) / MIN({FIXED [App], [Lens] : SUM([First Row])})' />
      </column>
      <column caption='1-Star Reviews' datatype='real' default-format='p0%' name='[Calc_OneStar]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([One Star] * [First Row]) / SUM([First Row])' />
      </column>
      <column caption='Peer Avg %' datatype='real' default-format='p0.0%' name='[Calc_PeerShare]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [App] &lt;&gt; &quot;DANA&quot; THEN [Share Weight] END) / 4' />
      </column>
      <column caption='Reviews per Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calc_PerDay]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Review ID]) / (DATEDIFF(&apos;day&apos;, MIN([Date]), MAX([Date])) + 1)' />
      </column>
      <column caption='Reviews' datatype='integer' default-format='n#,##0;-#,##0' name='[Calc_Reviews]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Review ID])' />
      </column>
      <column caption='1-Star Share of Theme' datatype='real' default-format='p0%' name='[Calc_Severity]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([One Star])' />
      </column>
      <column caption='% of Reviews' datatype='real' default-format='p0.0%' name='[Calc_Share]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Share Weight]) / COUNTD([App])' />
      </column>
      <column caption='Stars' datatype='string' name='[Calc_Stars]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([Rating]) + &quot; star&quot;' />
      </column>
      <column caption='Date' datatype='date' name='[Date]' role='dimension' type='ordinal' />
      <column caption='First Row' datatype='integer' name='[First Row]' role='measure' type='quantitative' />
      <column caption='Helpful Votes' datatype='integer' name='[Helpful Votes]' role='measure' type='quantitative' />
      <column caption='Lens' datatype='string' name='[Lens]' role='dimension' type='nominal' />
      <column caption='Negative' datatype='integer' name='[Negative]' role='measure' type='quantitative' />
      <column caption='One Star' datatype='integer' name='[One Star]' role='measure' type='quantitative' />
      <column caption='Peer Group' datatype='string' name='[Peer Group]' role='dimension' type='nominal' />
      <column caption='Rating' datatype='integer' name='[Rating]' role='dimension' type='ordinal' />
