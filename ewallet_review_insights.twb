        <cols />
      </table>
      <simple-id uuid='{A0CA6D08-7F8A-4E2A-843A-4618E1D5DA7E}' />
    </worksheet>
    <worksheet name='Reviews per day'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>Review velocity: new reviews per day</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dashboard_reviews' name='federated.ewalletreviews01' />
          </datasources>
          <datasource-dependencies datasource='federated.ewalletreviews01'>
            <column caption='App' datatype='string' name='[App]' role='dimension' type='nominal' />
            <column caption='Days Covered' datatype='integer' default-format='n#,##0;-#,##0' name='[Calc_Days]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, MIN([Date]), MAX([Date])) + 1' />
            </column>
            <column caption='Reviews per Day' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calc_PerDay]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Review ID]) / (DATEDIFF(&apos;day&apos;, MIN([Date]), MAX([Date])) + 1)' />
            </column>
            <column caption='Date' datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column caption='Lens' datatype='string' name='[Lens]' role='dimension' type='nominal' />
            <column caption='Peer Group' datatype='string' name='[Peer Group]' role='dimension' type='nominal' />
            <column caption='Review ID' datatype='string' name='[Review ID]' role='dimension' type='nominal' />
            <column-instance column='[App]' derivation='None' name='[none:App:nk]' pivot='key' type='nominal' />
            <column-instance column='[Lens]' derivation='None' name='[none:Lens:nk]' pivot='key' type='nominal' />
            <column-instance column='[Peer Group]' derivation='None' name='[none:Peer Group:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calc_Days]' derivation='User' name='[usr:Calc_Days:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calc_PerDay]' derivation='User' name='[usr:Calc_PerDay:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.ewalletreviews01].[none:App:nk]' direction='DESC' using='[federated.ewalletreviews01].[usr:Calc_PerDay:qk]' />
          <filter class='categorical' column='[federated.ewalletreviews01].[none:Lens:nk]'>
            <groupfilter function='member' level='[none:Lens:nk]' member='&quot;Latest 500&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.ewalletreviews01].[none:Lens:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.ewalletreviews01].[none:Peer Group:nk]' type='palette'>
              <map to='#118dff'>
                <bucket>&quot;DANA&quot;</bucket>
              </map>
              <map to='#b8bcc2'>
                <bucket>&quot;Peers&quot;</bucket>
              </map>
            </encoding>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.ewalletreviews01].[none:Peer Group:nk]' />
              <text column='[federated.ewalletreviews01].[usr:Calc_PerDay:qk]' />
              <tooltip column='[federated.ewalletreviews01].[usr:Calc_Days:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true'><![CDATA[<[federated.ewalletreviews01].[none:App:nk]>]]></run>
                <run>Æ&#10;</run>
                <run>Latest 500 reviews span </run>
                <run><![CDATA[<[federated.ewalletreviews01].[usr:Calc_Days:qk]>]]></run>
                <run> days = </run>
                <run bold='true'><![CDATA[<[federated.ewalletreviews01].[usr:Calc_PerDay:qk]>]]></run>
                <run> reviews per day</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.ewalletreviews01].[none:App:nk]</rows>
        <cols>[federated.ewalletreviews01].[usr:Calc_PerDay:qk]</cols>
      </table>
      <simple-id uuid='{9E28063A-2E3B-41BF-BF7C-15496711C4A4}' />
    </worksheet>
    <worksheet name='Star ratings of selection'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='11'>Star ratings of the selected reviews</run>
          </formatted-text>
        </title>
